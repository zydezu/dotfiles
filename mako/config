# `include` must appear before any [criteria] section
include=~/.config/mako/mako-colors

anchor=top-right
output=DP-1
layer=top
width=400
height=200
margin=12
padding=12,14
border-size=2
font=Hiragino Kaku Gothic Pro W3 11
border-radius=0
format=<b>%s</b>\n%b
icons=1
max-icon-size=40
max-visible=5
sort=-time
history=1
max-history=5
default-timeout=5000
ignore-timeout=0

[urgency=low]
default-timeout=4000

[urgency=critical]
default-timeout=0

# Actionable notifications (e.g. screenshot.sh's View/Annotate/Open):
# left-click opens a rofi menu of the notification's actions
[actionable=true]
on-button-left=exec makoctl menu -n "$id" -- rofi -dmenu -theme ~/.config/rofi/config.rasi -p "Action"

# DND: hide popups but keep them in the list until dismissed
[mode=dnd]
invisible=true
