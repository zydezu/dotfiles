{
  "actions": [
    {
      "type": "command",
      "label": "Run with python",
      "command_line": "alacritty --title 'python' -e bash -lc \"uv run '%f'\"",
      "cwd": "%d",
      "max_items": 1,
      "use_v1_interpolation": false,
      "mimetypes": [
        "text/x-python",
        "text/x-script.python"
      ]
    },
    {
      "type": "command",
      "label": "Open in Alacritty",
      "command_line": "alacritty --title 'alacritty'",
      "cwd": "%f",
      "max_items": 1,
      "use_v1_interpolation": false,
      "filetypes": [
        "!file"
      ]
    },
    {
      "type": "command",
      "label": "Open in Claude Code",
      "command_line": "alacritty --title 'claude' -e claude",
      "cwd": "%f",
      "max_items": 1,
      "use_v1_interpolation": false,
      "filetypes": [
        "!file"
      ]
    },
    {
      "type": "command",
      "label": "Open in Opencode",
      "command_line": "alacritty --title 'opencode' -e opencode",
      "cwd": "%f",
      "max_items": 1,
      "use_v1_interpolation": false,
      "filetypes": [
        "!file"
      ]
    },
    {
      "type": "command",
      "label": "Open in Zed",
      "command_line": "zeditor -n \"%f\"",
      "cwd": "%f",
      "max_items": 1,
      "use_v1_interpolation": false,
      "filetypes": [
        "!file"
      ]
    },
    {
      "type": "menu",
      "label": "Convert Files",
      "actions": [
        {
          "mimetypes": [
            "video/*"
          ],
          "label": "to h264",
          "type": "command",
          "command_line": "ffmpeg -i \"%f\" -c:v libx264 -crf 28 -c:a copy \"%d/%w_h264.mp4\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "video/*"
          ],
          "label": "to h265",
          "type": "command",
          "command_line": "ffmpeg -i \"%f\" -c:v libx265 -vtag hvc1 -profile:v main -pix_fmt yuv420p -crf 35 -c:a copy \"%d/%w_h265.mp4\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "video/*"
          ],
          "label": "to av1",
          "type": "command",
          "command_line": "ffmpeg -i \"%f\" -c:v libsvtav1 -crf 54 -preset 6 -c:a copy \"%d/%w_av1.mp4\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "label": "archival",
          "type": "menu",
          "actions": [
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "to h265 (hq archive)",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libx265 -vtag hvc1 -profile:v main -pix_fmt yuv420p -crf 20 -preset slow -c:a copy \"%d/%w_h265_hq.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "to av1 (hq archive)",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libsvtav1 -crf 22 -preset 3 -c:a copy \"%d/%w_av1_hq.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            }
          ]
        },
        {
          "label": "animated formats",
          "type": "menu",
          "actions": [
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "to gif",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -vf \"fps=30,scale=220:-1:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse\" -loop 0 \"%d/%w.gif\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "to gif (discord)",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -vf \"fps=20,scale=500:-1:flags=lanczos,crop=250:100,format=rgb24,split[s0][s1];[s0]palettegen=max_colors=128[p];[s1][p]paletteuse=dither=bayer:bayer_scale=5\" -loop 0 \"%d/%w.gif\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "to webp",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -loop 0 -c:v libwebp -lossless 0 -q:v 75 -compression_level 6 \"%d/%w.webp\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "to avif",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libsvtav1 -crf 42 -preset 6 \"%d/%w.avif\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "to avif (discord)",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libsvtav1 -crf 42 -preset 6 -vf \"scale=trunc(oh*a/2)*2:540\" \"%d/%w_540p.avif\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            }
          ]
        },
        {
          "label": "scale resolution",
          "type": "menu",
          "actions": [
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "144p",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libx265 -vtag hvc1 -vf scale=\"trunc(oh*a/2)*2:144\" \"%d/%w_144p.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "240p",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libx265 -vtag hvc1 -vf scale=\"trunc(oh*a/2)*2:240\" \"%d/%w_240p.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "360p",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libx265 -vtag hvc1 -vf scale=\"trunc(oh*a/2)*2:360\" \"%d/%w_360p.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "480p",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libx265 -vtag hvc1 -vf scale=\"trunc(oh*a/2)*2:480\" \"%d/%w_480p.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "720p",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libx265 -vtag hvc1 -vf scale=\"trunc(oh*a/2)*2:720\" \"%d/%w_720p.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "1080p",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libx265 -vtag hvc1 -vf scale=\"trunc(oh*a/2)*2:1080\" \"%d/%w_1080p.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            }
          ]
        },
        {
          "label": "change framerate",
          "type": "menu",
          "actions": [
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "12 FPS",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libx265 -vtag hvc1 -vf fps=12 \"%d/%w_12fps.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "24 FPS",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libx265 -vtag hvc1 -vf fps=24 \"%d/%w_24fps.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "30 FPS",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libx265 -vtag hvc1 -vf fps=30 \"%d/%w_30fps.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "60 FPS",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v libx265 -vtag hvc1 -vf fps=60 \"%d/%w_60fps.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            }
          ]
        },
        {
          "label": "adjust video speed",
          "type": "menu",
          "actions": [
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "0.5x",
              "type": "command",
              "command_line": "sh -c 'r=$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of csv=p=0 \"$1\"); ffmpeg -i \"$1\" -filter:v \"setpts=PTS/0.5\" -filter:a \"atempo=0.5\" -r \"$r\" \"$(dirname \"$1\")/$(basename \"$1\" | sed \"s/\\.[^.]*$//\")_0.5x.mp4\"' _ \"%f\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "2x",
              "type": "command",
              "command_line": "sh -c 'r=$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of csv=p=0 \"$1\"); ffmpeg -i \"$1\" -filter:v \"setpts=PTS/2.0\" -filter:a \"atempo=2.0\" -r \"$r\" \"$(dirname \"$1\")/$(basename \"$1\" | sed \"s/\\.[^.]*$//\")_2x.mp4\"' _ \"%f\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "4x",
              "type": "command",
              "command_line": "sh -c 'r=$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of csv=p=0 \"$1\"); ffmpeg -i \"$1\" -filter:v \"setpts=PTS/4.0\" -filter:a \"atempo=2.0,atempo=2.0\" -r \"$r\" \"$(dirname \"$1\")/$(basename \"$1\" | sed \"s/\\.[^.]*$//\")_4x.mp4\"' _ \"%f\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "5x",
              "type": "command",
              "command_line": "sh -c 'r=$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of csv=p=0 \"$1\"); ffmpeg -i \"$1\" -filter:v \"setpts=PTS/5.0\" -filter:a \"atempo=2.0,atempo=2.0,atempo=1.25\" -r \"$r\" \"$(dirname \"$1\")/$(basename \"$1\" | sed \"s/\\.[^.]*$//\")_5x.mp4\"' _ \"%f\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "10x",
              "type": "command",
              "command_line": "sh -c 'r=$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of csv=p=0 \"$1\"); ffmpeg -i \"$1\" -filter:v \"setpts=PTS/10.0\" -filter:a \"atempo=2.0,atempo=2.0,atempo=2.0,atempo=1.25\" -r \"$r\" \"$(dirname \"$1\")/$(basename \"$1\" | sed \"s/\\.[^.]*$//\")_10x.mp4\"' _ \"%f\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            }
          ]
        },
        {
          "label": "video audio track",
          "type": "menu",
          "actions": [
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "video (audio to AAC)",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v copy -c:a aac -b:a 128k \"%d/%w_aac.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "video (audio to opus)",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v copy -c:a libopus -vbr on -compression_level 10 \"%d/%w_opus.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "video (no audio)",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v copy -an \"%d/%w_noaudio.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "extract audio",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -vn -c:a copy \"%d/%w_audio.mka\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            },
            {
              "mimetypes": [
                "video/*"
              ],
              "label": "mute video",
              "type": "command",
              "command_line": "ffmpeg -i \"%f\" -c:v copy -an \"%d/%w_muted.mp4\"",
              "cwd": "%d",
              "use_v1_interpolation": false
            }
          ]
        },
        {
          "mimetypes": [
            "video/x-matroska"
          ],
          "label": "mkv to mp4",
          "type": "command",
          "command_line": "ffmpeg -i \"%f\" -map 0 -c copy \"%d/%w.mp4\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "video/quicktime"
          ],
          "label": "mov to mp4",
          "type": "command",
          "command_line": "ffmpeg -i \"%f\" -c copy -movflags +faststart \"%d/%w.mp4\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "image/avif"
          ],
          "label": "avif to gif",
          "type": "command",
          "command_line": "ffmpeg -i \"%f\" -map 0:v:1 -vf \"split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse\" -loop 0 \"%d/%w.gif\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "image/avif"
          ],
          "label": "avif to webp",
          "type": "command",
          "command_line": "ffmpeg -i \"%f\" -map 0:v:1 -loop 0 -c:v libwebp -lossless 0 -q:v 75 -compression_level 6 \"%d/%w.webp\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "image/avif"
          ],
          "label": "avif to mp4",
          "type": "command",
          "command_line": "ffmpeg -i \"%f\" -map 0:v:1 -c:v libx264 -pix_fmt yuv420p \"%d/%w.mp4\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "audio/*"
          ],
          "label": "audio to mp3",
          "type": "command",
          "command_line": "ffmpeg -i \"%f\" -ab 320k -map_metadata 0 -id3v2_version 3 \"%d/%w.mp3\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "audio/*"
          ],
          "label": "audio to opus",
          "type": "command",
          "command_line": "ffmpeg -i \"%f\" -c:a libopus -vbr on -compression_level 10 -application audio -map_metadata 0 \"%d/%w.opus\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "audio/mpeg"
          ],
          "label": "add album art to mp3",
          "type": "command",
          "command_line": "ffmpeg -i \"%f\" -i \"folder.jpg\" -map_metadata 0 -map 0:a -map 1 -c:a copy -c:v mjpeg -disposition:v attached_pic \"%d/%w_cover.mp3\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "audio/flac"
          ],
          "label": "add album art to FLAC",
          "type": "command",
          "command_line": "ffmpeg -i \"%f\" -i \"folder.jpg\" -map_metadata 0 -map 0:a -map 1 -c:a copy -c:v mjpeg -disposition:v attached_pic \"%d/%w_cover.flac\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "audio/flac",
            "audio/mpeg",
            "audio/mp4",
            "audio/x-m4a",
            "audio/ogg",
            "audio/opus",
            "audio/aac"
          ],
          "label": "extract album art",
          "type": "command",
          "command_line": "sh -c 'c=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 \"$1\"); e=$c; [ \"$c\" = mjpeg ] && e=jpg; ffmpeg -i \"$1\" -an -c:v copy \"$(dirname \"$1\")/$(basename \"$1\" | sed \"s/\\.[^.]*$//\")_cover.$e\"' _ \"%f\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "image/*",
            "!image/gif"
          ],
          "label": "image to avif",
          "type": "command",
          "command_line": "magick \"%f\" \"%d/%w.avif\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "image/*",
            "!image/gif"
          ],
          "label": "image to png",
          "type": "command",
          "command_line": "magick \"%f\" \"%d/%w.png\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "image/*",
            "!image/gif"
          ],
          "label": "image to jpg",
          "type": "command",
          "command_line": "magick \"%f\" \"%d/%w.jpg\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "image/*",
            "!image/gif"
          ],
          "label": "image to webp",
          "type": "command",
          "command_line": "magick \"%f\" -quality 80 \"%d/%w.webp\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "image/*",
            "!image/gif"
          ],
          "label": "image to jpeg-xl (lossless)",
          "type": "command",
          "command_line": "cjxl \"%f\" \"%d/%w.lossless.jxl\" -d 0 -e 9",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "image/*",
            "!image/gif"
          ],
          "label": "image to webp (lossless)",
          "type": "command",
          "command_line": "cwebp -lossless -z 9 \"%f\" -o \"%d/%w.lossless.webp\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        },
        {
          "mimetypes": [
            "image/gif"
          ],
          "label": "gif to avif",
          "type": "command",
          "command_line": "ffmpeg -i \"%f\" -c:v libsvtav1 -crf 42 -preset 6 \"%d/%w.avif\"",
          "cwd": "%d",
          "use_v1_interpolation": false
        }
      ]
    }
  ],
  "sort": "manual",
  "debug": false
}
