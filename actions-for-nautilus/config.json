less 0 -q:v 75 -compression_level 6 \"$(dirname \"$f\")/${b}.webp\"' _ \"%f\"", "cwd": "%d", "use_v1_interpolation": false}, {"mimetypes": ["image/avif"], "label": "AVIF to MP4", "type": "command", "command_line": "sh -c 'f=\"$1\"; b=${f##*/}; b=${b%.*}; s=$(ffprobe -v error -select_streams v -show_entries stream=index,nb_frames -of csv=p=0 \"$f\" | sort -t, -k2,2nr | head -1 | cut -d, -f1); ffmpeg -i \"$f\" -map \"0:v:$s\" -c:v libsvtav1 -crf 38 -preset 6 -vf \"scale=trunc(iw/2)*2:trunc(ih/2)*2\" \"$(dirname \"$f\")/${b}.mp4\"' _ \"%f\"", "cwd": "%d", "use_v1_interpolation": false}]}], "sort": "manual", "debug": false}